# HTTP service
PORT=4310
PROSPECTOR_DB_PATH=data\azure-prospector.db

# auto checks Azure CLI first, then uses browser sign-in when configured.
# Also supported: azure-cli, browser, managed-identity, default-credential.
PROSPECTOR_AUTH_MODE=auto
AZURE_TENANT_ID=
# User-assigned managed identity client ID for hosted deployments.
AZURE_CLIENT_ID=

# Optional branded production registration. Local brokered sign-in can use the
# Azure Identity development application when this is unset.
PROSPECTOR_BROWSER_CLIENT_ID=
# Optional redirect for a custom public-client registration.
PROSPECTOR_REDIRECT_URI=

# Optional comma-separated allow-list. Empty means every visible enabled subscription.
PROSPECTOR_SUBSCRIPTION_IDS=

# Ordered, comma-separated tag keys used to infer ownership.
PROSPECTOR_OWNER_TAGS=owner,serviceOwner,applicationOwner,technicalOwner

# Cost Management evidence budget. Prospector requests up to this many
# completed months while keeping the estimated tenant-wide query cost at or
# below this many QPUs per scan.
AZURE_COST_HISTORY_MONTHS=6
AZURE_COST_QPU_BUDGET_PER_SCAN=480
